# Copy to .env and fill in YOUR values. Never commit .env.
# simulated = no external calls, nothing is spent (used in CI) | live = real model API
LLM_MODE=simulated
# Live mode only (decision 3 in docs/decisions.md): Groq with openai/gpt-oss-120b
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# Source search (I4). brave = Brave Search API (needs BRAVE_API_KEY); static = offline JSON index
SEARCH_PROVIDER=
BRAVE_API_KEY=
# SEARCH_STATIC_INDEX=data/search_index.json
# SOURCES_USER_AGENT=AIShareOfVoiceBot/0.1 (+https://github.com/JCRbit/ai-share-of-voice)
# Spending caps in USD: per run, and per person across all your runs (needs the call log)
SPEND_CAP_USD=2.00
PERSON_CAP_USD=5.00
# Only if you use a model other than the default or Groq changes its prices (USD per 1M tokens)
# LLM_PRICE_INPUT_PER_M=0.15
# LLM_PRICE_OUTPUT_PER_M=0.60

# Image analysis (I5). Needs a vision-capable model; text models such as the default cannot see images.
# VISION_MODEL=
# VISION_PRICE_INPUT_PER_M=
# VISION_PRICE_OUTPUT_PER_M=
