# Copy to .env and fill in YOUR values. Never commit .env.

# simulated = no external calls (tests and CI) | live = real model API
LLM_MODE=simulated
LLM_PROVIDER=groq
# Create it at https://console.groq.com/keys (shown only once).
LLM_API_KEY=
# Optional: leave blank to use the provider's endpoint.
LLM_BASE_URL=

# Leave blank to use the defaults in src/ai_share_of_voice/config.py.
# Subject model: the one we measure. Agent model: the one that runs the agents.
# The subject may use another provider: groq | gemini. Blank = same as LLM_PROVIDER.
SUBJECT_PROVIDER=
# Needed only when no key of that provider is set above. Gemini: https://aistudio.google.com/apikey
SUBJECT_API_KEY=
SUBJECT_BASE_URL=
SUBJECT_MODEL=
LLM_MODEL=
# Vision may use another provider too. Blank key = reuse a key of the same provider.
VISION_PROVIDER=
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=

# Hard cap for one run, in US dollars.
SPEND_CAP_USD=0.50

# Web sources for the researcher: none (fixtures only) | duckduckgo (no key) | tavily (key)
SEARCH_PROVIDER=none
SEARCH_API_KEY=

# Public demo only: one shared password asked before any call that spends model budget.
# Set it as a secret of the host, never in the repository. Blank = no password (local use).
DEMO_PASSWORD=
